{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "const": "contacts.upsert"
    },
    "payload": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "account_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "at",
              "action"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "person_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "emails": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 254
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "phones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "organization": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "maxItems": 50,
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000
        },
        "archived": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "account_id",
        "created_at",
        "updated_at",
        "history",
        "display_name",
        "person_id",
        "emails",
        "phones",
        "organization",
        "groups",
        "notes",
        "archived"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "at",
    "operation",
    "payload"
  ],
  "additionalProperties": false
}
