                                        "minimum": 0
                                      },
                                      "channels": {
                                        "type": "integer",
                                        "minimum": 0
                                      }
                                    },
                                    "required": [],
                                    "additionalProperties": false
                                  },
                                  "video": {
                                    "type": "object",
                                    "properties": {
                                      "duration_ms": {
                                        "type": "integer",
                                        "minimum": 0
                                      },
                                      "codec": {
                                        "type": "string",
                                        "minLength": 1
                                      },
                                      "width": {
                                        "type": "integer",
                                        "minimum": 0
                                      },
                                      "height": {
                                        "type": "integer",
                                        "minimum": 0
                                      },
                                      "fps": {
                                        "type": "number",
                                        "minimum": 0
                                      },
                                      "has_audio": {
                                        "type": "boolean"
                                      }
                                    },
                                    "required": [],
                                    "additionalProperties": false
                                  },
                                  "document": {
                                    "type": "object",
                                    "properties": {
                                      "page_count": {
                                        "type": "integer",
                                        "minimum": 0
                                      },
                                      "text_asset_id": {
                                        "type": "string",
                                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,149}$"
                                      }
                                    },
                                    "required": [],
                                    "additionalProperties": false
                                  },
                                  "sensor": {
