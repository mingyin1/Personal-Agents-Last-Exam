{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rainshadow account and world records",
  "description": "History accepted by env.load_seed and kept as App data. World records (zones, places, sources, issuances, observations, alerts) and one account (preferences, saved places, acknowledgements, watches, notices, activity). Every record in a seed counts as already issued. Time-based states are not stored: a notice carries its release time and a watch its window end, and both are read against the environment clock.",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "owner_person_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "zone_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "region",
          "timezone",
          "zone_ids"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "enum": [
              "weather",
              "air_quality"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    },
    "issuances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "place_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "hourly": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "temp_c": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 60
                },
                "apparent_temp_c": {
                  "type": "number",
                  "minimum": -110,
                  "maximum": 70
                },
                "pop": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "precip_mm": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 500
                },
                "wind_kph": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 400
                },
                "gust_kph": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 500
                },
                "thunder_prob": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "sky": {
                  "enum": [
                    "clear",
                    "mostly_clear",
                    "partly_cloudy",
                    "mostly_cloudy",
                    "cloudy",
                    "fog",
                    "haze",
                    "smoke",
                    "drizzle",
                    "rain",
                    "heavy_rain",
                    "thunderstorm",
                    "sleet",
                    "snow"
                  ]
                }
              },
              "required": [
                "start",
                "temp_c",
                "apparent_temp_c",
                "pop",
                "precip_mm",
                "wind_kph",
                "gust_kph",
                "thunder_prob",
                "sky"
              ],
              "additionalProperties": false
            },
            "maxItems": 240
          },
          "daily": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "date": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    },
                    "headline": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "summary": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 600
                    },
                    "high_c": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 60
                    },
                    "low_c": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 60
                    },
                    "pop_day": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "pop_night": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "date",
                    "headline",
                    "summary",
                    "high_c",
                    "low_c",
                    "pop_day",
                    "pop_night"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "date": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    },
                    "aqi": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 500
                    },
                    "pollutant": {
                      "enum": [
                        "pm25",
                        "pm10",
                        "ozone",
                        "no2",
                        "so2",
                        "co"
                      ]
                    }
                  },
                  "required": [
                    "date",
                    "aqi"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "maxItems": 16
          }
        },
        "required": [
          "id",
          "source_id",
          "place_id",
          "issued_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 400
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "place_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "temp_c": {
            "type": "number",
            "minimum": -90,
            "maximum": 60
          },
          "wind_kph": {
            "type": "number",
            "minimum": 0,
            "maximum": 400
          },
          "gust_kph": {
            "type": "number",
            "minimum": 0,
            "maximum": 500
          },
          "conditions": {
            "enum": [
              "clear",
              "mostly_clear",
              "partly_cloudy",
              "mostly_cloudy",
              "cloudy",
              "fog",
              "haze",
              "smoke",
              "drizzle",
              "rain",
              "heavy_rain",
              "thunderstorm",
              "sleet",
              "snow"
            ]
          },
          "humidity": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "id",
          "place_id",
          "source_id",
          "observed_at",
          "temp_c",
          "wind_kph",
          "gust_kph",
          "conditions"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "category": {
            "enum": [
              "flood",
              "storm",
              "winter",
              "wind",
              "temperature",
              "fire",
              "air_quality",
              "other"
            ]
          },
          "zone_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            },
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                },
                "type": {
                  "enum": [
                    "alert",
                    "update",
                    "cancel"
                  ]
                },
                "sent_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "event": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "severity": {
                  "enum": [
                    "minor",
                    "moderate",
                    "severe",
                    "extreme"
                  ]
                },
                "urgency": {
                  "enum": [
                    "immediate",
                    "expected",
                    "future",
                    "past",
                    "unknown"
                  ]
                },
                "certainty": {
                  "enum": [
                    "observed",
                    "likely",
                    "possible",
                    "unlikely",
                    "unknown"
                  ]
                },
                "onset": {
                  "type": "string",
                  "format": "date-time"
                },
                "ends": {
                  "type": "string",
                  "format": "date-time"
                },
                "headline": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "instruction": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "message_id",
                "type",
                "sent_at",
                "headline",
                "description"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "id",
          "source_id",
          "category",
          "zone_ids",
          "messages"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "preferences": {
      "type": "object",
      "properties": {
        "units": {
          "enum": [
            "metric",
            "us"
          ]
        },
        "default_source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "default_air_source_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
            }
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "quiet_hours": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "start": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "end": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          },
          "required": [
            "enabled",
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "email_notices": {
          "type": "boolean"
        }
      },
      "required": [
        "units",
        "default_source_id",
        "default_air_source_id",
        "timezone",
        "quiet_hours",
        "email_notices"
      ],
      "additionalProperties": false
    },
    "saved_places": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "place_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "alert_rule": {
            "type": "object",
            "properties": {
              "categories": {
                "type": "array",
                "items": {
                  "enum": [
                    "flood",
                    "storm",
                    "winter",
                    "wind",
                    "temperature",
                    "fire",
                    "air_quality",
                    "other"
                  ]
                },
                "maxItems": 8,
                "uniqueItems": true
              },
              "min_severity": {
                "enum": [
                  "minor",
                  "moderate",
                  "severe",
                  "extreme"
                ]
              },
              "paused": {
                "type": "boolean"
              }
            },
            "required": [
              "categories",
              "min_severity",
              "paused"
            ],
            "additionalProperties": false
          },
          "saved_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "place_id",
          "label",
          "alert_rule",
          "saved_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "acknowledgements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alert_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "message_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "acknowledged_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "alert_id",
          "message_id",
          "acknowledged_at"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "watches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "place_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "aq_source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "conditions": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "variable": {
                      "enum": [
                        "pop",
                        "thunder_prob",
                        "precip",
                        "wind_gust",
                        "wind_speed",
                        "temp",
                        "apparent_temp",
                        "aqi"
                      ]
                    },
                    "op": {
                      "enum": [
                        "gte",
                        "lte"
                      ]
                    },
                    "value": {
                      "type": "number",
                      "minimum": -200,
                      "maximum": 1000
                    },
                    "unit": {
                      "enum": [
                        "%",
                        "mm",
                        "in",
                        "km/h",
                        "mph",
                        "C",
                        "F",
                        "index"
                      ]
                    }
                  },
                  "required": [
                    "variable",
                    "op",
                    "value",
                    "unit"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "variable": {
                      "const": "alert"
                    },
                    "category": {
                      "enum": [
                        "any",
                        "flood",
                        "storm",
                        "winter",
                        "wind",
                        "temperature",
                        "fire",
                        "air_quality",
                        "other"
                      ]
                    },
                    "min_severity": {
                      "enum": [
                        "minor",
                        "moderate",
                        "severe",
                        "extreme"
                      ]
                    }
                  },
                  "required": [
                    "variable",
                    "category",
                    "min_severity"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1,
            "maxItems": 6
          },
          "linked_object": {
            "type": "object",
            "properties": {
              "app_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "object_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "object_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              }
            },
            "required": [
              "app_id",
              "object_id"
            ],
            "additionalProperties": false
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "cancelled_at": {
            "type": "string",
            "format": "date-time"
          },
          "evaluation": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "no_data",
                  "clear",
                  "triggered"
                ]
              },
              "evaluated_at": {
                "type": "string",
                "format": "date-time"
              },
              "cause": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "request_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "event_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              "issuance": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                      },
                      "issued_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "id",
                      "issued_at"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "aq_issuance": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                      },
                      "issued_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "id",
                      "issued_at"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "hours": {
                "type": "object",
                "properties": {
                  "considered": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 240
                  },
                  "missing": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "maxItems": 240
                  },
                  "frozen": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "considered",
                  "missing"
                ],
                "additionalProperties": false
              },
              "dates": {
                "type": "object",
                "properties": {
                  "considered": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12
                  },
                  "missing": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    },
                    "maxItems": 12
                  }
                },
                "required": [
                  "considered",
                  "missing"
                ],
                "additionalProperties": false
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    },
                    "evaluable": {
                      "type": "boolean"
                    },
                    "met": {
                      "type": "boolean"
                    },
                    "matches": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "date": {
                            "type": "string",
                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                          },
                          "alert_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                          },
                          "message_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
                          },
                          "value": {
                            "type": "number"
                          },
                          "unit": {
                            "enum": [
                              "%",
                              "mm",
                              "in",
                              "km/h",
                              "mph",
