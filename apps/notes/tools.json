  {
    "name": "notes.attachment.add",
    "description": "Attach verified bytes to an active record.",
    "read_only": false,
    "scope": "notes.attachment.add",
    "resource_target": "current account",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,99}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[^\\\\/\\u0000-\\u001f\\u007f]+$"
              },
              "mime_type": {
                "enum": [
                  "application/pdf",
                  "text/calendar",
                  "text/plain",
                  "image/png",
                  "image/jpeg",
                  "audio/mpeg",
                  "audio/wav",
                  "video/mp4",
                  "application/json"
                ]
              },
              "base64": {
                "type": "string",
                "maxLength": 1398104
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "media": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "object",
                    "properties": {
                      "width": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 0
                      },
