    "example:attachments": "node examples/workflows/attachments/run.cjs",
    "test:personal-apps": "node runtime/tests/personal-apps.cjs",
    "example:personal-apps": "node examples/workflows/personal-apps/run.cjs",
    "web": "node runtime/web/server.cjs",
    "test:web": "node --test runtime/web/host.test.cjs",
    "test:web:browser": "node runtime/web/browser.test.cjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
